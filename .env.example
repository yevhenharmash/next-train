# Rail Data Marketplace consumer key (Live Departure Board product).
# Server-side only: read by the dev proxy and api/board.ts. NEVER prefix it with VITE_.
# Without it, `pnpm dev` serves generated demo data.
RDM_KEY=

# Optional. The product's base URL from your subscription's API tab, if it differs from the default
# https://api1.raildata.org.uk/1010-live-departure-board-dep1_2/LDBWS/api/20220120
RDM_BASE_URL=

# Optional, public: your Ko-fi / Buy Me a Coffee / GitHub Sponsors page. When set, a "Say thanks"
# button shows in the footer. VITE_ is fine here: it's meant to be seen.
VITE_DONATE_URL=
